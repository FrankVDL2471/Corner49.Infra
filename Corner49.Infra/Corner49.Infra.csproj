<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>    <GenerateDocumentationFile>true</GenerateDocumentationFile>    <Title>Corner49 Infra</Title>
    <Authors>Frank Vanderlinden</Authors>
    <Description>Opinionated bootstrap for ASP.NET Core web apps and APIs: configuration, logging, OpenAPI, Auth0, health checks, jobs, Cosmos DB, Service Bus and Blob Storage. The main package of the Corner49.Infra packages</Description>
    <PackageTags>corner49;infrastructure;aspnetcore;azure</PackageTags>
    <PackageProjectUrl>https://github.com/FrankVDL2471/Corner49.Infra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FrankVDL2471/Corner49.Infra</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
		<RootNamespace>Corner49.Infra</RootNamespace>

	</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Azure.SignalR.Management" Version="1.33.1" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="3.1.2" />
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="8.6.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.AzureAppServices" Version="10.0.11" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Auth0.AspNetCore.Authentication" Version="1.11.0" />
    <PackageReference Include="TimeZoneConverter" Version="7.2.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Corner49.Infra.AzureCosmosDB\Corner49.Infra.AzureCosmosDB.csproj" />
    <ProjectReference Include="..\Corner49.Infra.AzureServiceBus\Corner49.Infra.AzureServiceBus.csproj" />
    <ProjectReference Include="..\Corner49.Infra.AzureStorage\Corner49.Infra.AzureStorage.csproj" />
    <ProjectReference Include="..\Corner49.Infra.Core\Corner49.Infra.Core.csproj" />
    <ProjectReference Include="..\Corner49.Infra.Hangfire\Corner49.Infra.Hangfire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>